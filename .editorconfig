# Estilo común para cualquier editor (https://editorconfig.org), sin
# dependencias. El fin de línea LF lo fija también .gitattributes.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

# En Markdown, dos espacios al final de línea son un salto
[*.md]
trim_trailing_whitespace = false

# Archivos de terceros (licencias, glifos de Meta, sprite de Lucide y
# three.js): se dejan tal cual
[{assets/fonts/*.txt,assets/marcas/*.svg,assets/icons/*,lib/three/*}]
indent_style = unset
indent_size = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
